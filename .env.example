# Copy to .env.local and fill in. Never commit real keys.

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Resend (server-side only — never expose to the browser)
RESEND_API_KEY=
# Until your domain is verified, use Resend's shared sender and route every email to your own inbox
# (the address you signed up to Resend with). Remove RESEND_TEST_INBOX after verifying the domain.
RESEND_FROM_EMAIL="CoreDefense <onboarding@resend.dev>"
RESEND_TEST_INBOX=you@example.com
RESEND_TO_EMAIL=info@coredefense.co.uk

# Auth: random string that signs sign-in codes (node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
AUTH_SECRET=
# Emails that become admins when they sign up (comma-separated)
ADMIN_EMAILS=

# Calendly
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/coredefense/consultation

# Site
NEXT_PUBLIC_SITE_URL=https://www.coredefense.co.uk
